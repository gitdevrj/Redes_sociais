# ============================================================
# AutoPost — variáveis de ambiente
# Copie para .env e preencha. NUNCA versione o arquivo .env.
# ============================================================

# --- Modo de operação ---
# DRY_RUN=true gera tudo mas NÃO publica nada (padrão até as contas estarem configuradas).
DRY_RUN=true

# --- IA (Claude) ---
# Sem chave, o sistema roda em modo "offline" (heurístico) e tudo vai para revisão humana.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
# low | medium | high  (esforço de raciocínio; medium é um bom equilíbrio custo/qualidade)
CLAUDE_EFFORT=medium
# auto = usa Claude se houver chave, senão offline | claude | offline
AI_PROVIDER=auto

# --- Transcrição (faster-whisper local) ---
WHISPER_ENABLED=true
# tiny | base | small | medium | large-v3  (small é bom em CPU no Windows)
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# --- Painel de revisão ---
REVIEW_HOST=127.0.0.1
REVIEW_PORT=8000
REVIEW_USER=admin
REVIEW_PASSWORD=troque-esta-senha

# --- Telegram (bot de envio de mídia e aprovação) ---
# Crie o bot com o @BotFather e pegue o token.
TELEGRAM_BOT_TOKEN=
# Seu ID numérico do Telegram (descubra com o @userinfobot). Vários separados por vírgula.
TELEGRAM_ALLOWED_USER_IDS=
# Chat que recebe as notificações (normalmente o mesmo ID acima).
TELEGRAM_NOTIFY_CHAT_ID=
# Deixe padrão. Para vídeos > 20 MB, rode o Local Bot API Server e aponte para ele
# (ex.: http://telegram-bot-api:8081) — veja README.
TELEGRAM_API_BASE=https://api.telegram.org
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# --- Meta (Instagram + Facebook) — Fase 3 ---
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_PAGE_ID=
META_IG_USER_ID=
META_GRAPH_VERSION=v27.0

# --- LinkedIn (perfil pessoal) — Fase 3 ---
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_REFRESH_TOKEN=
LINKEDIN_PERSON_URN=
LINKEDIN_VERSION=202610

# --- YouTube (Data API v3, OAuth de app "Desktop") — Fase 3 ---
YOUTUBE_CLIENT_SECRETS_FILE=config/secrets/youtube_client_secret.json
YOUTUBE_TOKEN_FILE=data/youtube_token.json

# --- Google Drive (hospedagem pública de imagens para a Meta) — Fase 3 ---
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_DRIVE_FOLDER_ID=

# --- Watcher ---
# true = verificação periódica (necessário no Docker Desktop do Windows e em pastas do Google Drive)
WATCHER_POLLING=false

# --- Caminhos (opcional) ---
# AUTOPOST_BASE_DIR=.
LOG_LEVEL=INFO
